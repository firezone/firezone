<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="AppTheme.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/neutral_900</item>
        <item name="android:colorBackground">@color/portal_canvas</item>
        <item name="android:windowBackground">@color/portal_canvas</item>
        <!-- The bars are transparent from API 35 on, so their icons have to be dark
             against the light background showing through. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="AppTheme.Base.HeaderText">
        <item name="fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.H1">
        <item name="fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.H2">
        <item name="fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.H3">
        <item name="fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.H4">
        <item name="fontFamily">@font/source_sans_pro_bold</item>
        <item name="android:textSize">@dimen/text_h4</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.Body2">
        <item name="fontFamily">@font/source_sans_pro</item>
        <item name="android:textSize">@dimen/text_body2</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

    <style name="AppTheme.Base.Caption">
        <item name="fontFamily">@font/source_sans_pro</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColorPrimary">@color/neutral_900</item>
    </style>

</resources>
