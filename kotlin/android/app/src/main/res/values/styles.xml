<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/neutral_900</item>
        <item name="android:colorBackground">@color/portal_canvas</item>
        <item name="android:windowBackground">@color/portal_canvas</item>
        <!-- The bars are transparent from API 35 on, so their icons have to be dark
             against the light background showing through. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- The window the system draws before the app has one of its own. `installSplashScreen` holds
         it while the launch decides where to go, then swaps in `postSplashScreenTheme`, so the app
         never draws a second splash of its own. The icon is masked to a circle, which leaves room
         for the mark but not for the wordmark beside it. -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/portal_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_firezone_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Base</item>
    </style>

</resources>
