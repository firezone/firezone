#!/bin/bash

# Puts the headless client on the PATH. The installer passes the install location as $2.

set -euo pipefail

# Only the CLI lives in this directory, so nothing else in the bundle becomes a
# command. path_helper adds it to the PATH of every login shell.
bin="$2/Firezone.app/Contents/Resources/bin"
echo "$bin" >/etc/paths.d/firezone
chmod 0644 /etc/paths.d/firezone

install_completion() {
    local shell="$1"
    local path="$2"

    mkdir -p "$(dirname "$path")"
    "$bin/firezone" --generate-completion-script "$shell" >"$path"
}

# Each of these is where the shell picks completions up on its own. Best-effort,
# because putting the client on the PATH is what this install is for and a shell
# nobody uses must not fail it.
install_completion zsh /usr/local/share/zsh/site-functions/_firezone || true
install_completion bash /usr/local/etc/bash_completion.d/firezone || true
install_completion fish /usr/local/share/fish/vendor_completions.d/firezone.fish || true
