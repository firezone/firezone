{
  "build": {
    "beforeDevCommand": "pnpm vite dev",
    "beforeBuildCommand": "",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "shortDescription": "Firezone",
    "linux": {
      "deb": {
        "recommends": ["p11-kit-modules"],
        "preInstallScript": "./linux_package/preinst",
        "postInstallScript": "./linux_package/postinst",
        "preRemoveScript": "./linux_package/prerm_deb",
        "files": {
          "/usr/bin/firezone": "../../target/release/firezone",
          "/usr/lib/systemd/system/firezone.service": "../../headless-client/debian/firezone.service",
          "/usr/lib/sysusers.d/firezone.conf": "../../headless-client/debian/firezone.sysusers",
          "/usr/lib/tmpfiles.d/firezone.conf": "../../headless-client/debian/firezone.tmpfiles",
          "/usr/share/polkit-1/rules.d/10-firezone.rules": "../../headless-client/debian/10-firezone.rules",
          "/usr/share/bash-completion/completions/firezone": "../../target/release/completions/firezone.bash",
          "/usr/share/zsh/site-functions/_firezone": "../../target/release/completions/_firezone",
          "/usr/share/fish/vendor_completions.d/firezone.fish": "../../target/release/completions/firezone.fish",
          "/usr/share/metainfo/dev.firezone.client.metainfo.xml": "./linux_package/dev.firezone.client.metainfo.xml"
        },
        "desktopTemplate": "./linux_package/firezone-client-gui.desktop",
        "provides": [
          "firezone",
          "firezone-gateway",
          "firezone-headless-client"
        ],
        "conflicts": [
          "firezone",
          "firezone-gateway",
          "firezone-headless-client"
        ],
        "replaces": ["firezone", "firezone-gateway", "firezone-headless-client"]
      },
      "rpm": {
        "recommends": ["p11-kit"],
        "postInstallScript": "./linux_package/postinst",
        "preRemoveScript": "./linux_package/prerm_rpm",
        "files": {
          "/usr/bin/firezone": "../../target/release/firezone",
          "/usr/lib/systemd/system/firezone.service": "../../headless-client/debian/firezone.service",
          "/usr/lib/sysusers.d/firezone.conf": "../../headless-client/debian/firezone.sysusers",
          "/usr/lib/tmpfiles.d/firezone.conf": "../../headless-client/debian/firezone.tmpfiles",
          "/usr/share/polkit-1/rules.d/10-firezone.rules": "../../headless-client/debian/10-firezone.rules",
          "/usr/share/bash-completion/completions/firezone": "../../target/release/completions/firezone.bash",
          "/usr/share/zsh/site-functions/_firezone": "../../target/release/completions/_firezone",
          "/usr/share/fish/vendor_completions.d/firezone.fish": "../../target/release/completions/firezone.fish",
          "/usr/share/metainfo/dev.firezone.client.metainfo.xml": "./linux_package/dev.firezone.client.metainfo.xml"
        },
        "desktopTemplate": "./linux_package/firezone-client-gui.desktop",
        "provides": [
          "firezone",
          "firezone-gateway",
          "firezone-headless-client"
        ],
        "conflicts": [
          "firezone",
          "firezone-gateway",
          "firezone-headless-client"
        ],
        "obsoletes": [
          "firezone",
          "firezone-gateway",
          "firezone-headless-client"
        ]
      }
    },
    "targets": ["deb", "msi", "rpm"],
    "windows": {
      "wix": {
        "bannerPath": "./win_files/banner.png",
        "componentRefs": [
          "RemoveOldFirezoneService",
          "FirezoneClientTunnelService",
          "SparsePackageMsix",
          "RegisterSparseExe",
          "FirezoneCli"
        ],
        "dialogImagePath": "./win_files/install_dialog.png",
        "fragmentPaths": [
          "./win_files/service.wxs",
          "./win_files/sparse-package.wxs",
          "./win_files/cli.wxs"
        ],
        "template": "./win_files/main.wxs"
      }
    },
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Firezone"
  },
  "mainBinaryName": "firezone-client-gui",
  "identifier": "dev.firezone.client",
  "plugins": {},
  "productName": "firezone-client-gui",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://sentry.firezone.dev; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'none'",
      "capabilities": ["default-capability"]
    },
    "windows": [
      {
        "decorations": false,
        "label": "main",
        "title": "Firezone",
        "url": "index.html",
        "fullscreen": false,
        "resizable": false,
        "width": 900,
        "height": 500,
        "visible": false,
        "transparent": true
      }
    ]
  }
}
