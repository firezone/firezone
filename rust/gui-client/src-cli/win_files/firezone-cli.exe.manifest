<?xml version="1.0" encoding="utf-8"?>
<!--
  Side-by-side / fusion manifest embedded into firezone-cli.exe, which
  the installer places at `cli\firezone.exe`, so the Windows kernel
  attaches the Firezone sparse-MSIX package identity to the process at
  `CreateProcess` time. The GUI's IPC pipe grants read/write only to
  processes carrying that identity, so without this the CLI is denied
  on every connection.

  `publisher` + `packageName` must match the `Identity` element in
  `src-tauri/win_files/AppxManifest.xml`; `applicationId` must match
  the `Id` attribute of an `<Application>` in that manifest, whose
  `Executable` in turn has to name the installed path, not the name
  this binary is built under. See
  https://learn.microsoft.com/en-us/windows/apps/desktop/modernize/grant-identity-to-nonpackaged-apps
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- mark:next-gui-version -->
  <assemblyIdentity version="1.5.18.0" name="Firezone.Client.CLI" />
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=&quot;Firezone, Inc.&quot;, O=&quot;Firezone, Inc.&quot;, STREET=&quot;2261 Market Street, Suite 4574&quot;, L=San Francisco, S=California, C=US, OID.1.3.6.1.4.1.311.60.2.1.2=Delaware, OID.1.3.6.1.4.1.311.60.2.1.3=US, SERIALNUMBER=6383880, OID.2.5.4.15=Private Organization"
        packageName="Firezone.Client.GUI"
        applicationId="FirezoneCli" />
</assembly>
