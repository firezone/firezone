#!/usr/bin/env bash
#MISE description="Run the tests of `client-ffi` and its workspace dependencies on a dinghy platform, one test binary at a time"
set -euo pipefail

platform="${1:?usage: mise run //rust:mobile-test <dinghy-platform> <triple>}"
triple="${2:?usage: mise run //rust:mobile-test <dinghy-platform> <triple>}"
binary_timeout="${MOBILE_TEST_BINARY_TIMEOUT_SECS:-300}"
test_timeout="${MOBILE_TEST_TIMEOUT_SECS:-60}"
failed=()
binaries_file="$(mktemp)"
tests_file="$(mktemp)"

read -ra flags <<<"$(mise run -q //rust:mobile-test-packages "$triple")"

# Build everything in one invocation: building per package would re-resolve features and recompile.
cargo dinghy -p "$platform" test --no-run --message-format=json "${flags[@]}" |
    grep '^{' |
    jq -r 'select(.reason == "compiler-artifact" and .executable != null and .profile.test) | "\(.manifest_path | sub("/Cargo.toml$"; ""))\t\(.executable)"' \
        >"$binaries_file"

set -m # Each run gets its own process group, so a timeout kills dinghy and whatever it spawned.

# Exits with 124 if the command is still running after the given number of seconds.
run_with_timeout() {
    local secs="$1"
    shift

    "$@" </dev/null &
    local pid=$!
    (sleep "$secs" && kill -- "-$pid") &
    local watchdog=$!
    disown "$watchdog"

    local status=0
    wait "$pid" || status=$?
    if ! kill -- "-$watchdog" 2>/dev/null; then
        return 124
    fi
    return "$status"
}

# `dinghy runner` is what cargo invokes for each test binary; it expects the crate directory as its working directory.
run_on_device() {
    local secs="$1"
    shift

    pushd "$dir" >/dev/null
    local status=0
    CARGO_PKG_NAME="$(basename "$dir")" run_with_timeout "$secs" cargo dinghy -p "$platform" runner -- "$exe" "$@" || status=$?
    popd >/dev/null
    return "$status"
}

while IFS=$'\t' read -r dir exe; do
    name="$(basename "$dir")/$(basename "$exe")"
    echo "::group::$name"

    status=0
    run_on_device "$binary_timeout" --test-threads=1 --nocapture || status=$?

    if ((status == 124)); then
        # The device only hands back a test binary's output once it exits, so find the test that hangs by running each on its own.
        echo "::error::$name timed out after ${binary_timeout}s, running its tests one by one"

        run_on_device "$test_timeout" --list --format terse >"$tests_file" 2>/dev/null || true

        while read -r test; do
            test_status=0
            run_on_device "$test_timeout" --exact "$test" --nocapture || test_status=$?

            case "$test_status" in
            0) ;;
            124) echo "::error::$name: $test timed out after ${test_timeout}s" ;;
            *) echo "::error::$name: $test failed" ;;
            esac
        done < <(sed -n 's/: test$//p' "$tests_file")
    fi

    if ((status != 0)); then
        failed+=("$name")
    fi

    echo "::endgroup::"
done <"$binaries_file"

if ((${#failed[@]} > 0)); then
    echo "::error::Failed test binaries: ${failed[*]}"
    exit 1
fi
