<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= @heading %></title></head>
<body style="margin:0;background:#f6f6f6;font-family:Arial,sans-serif;color:#4f4f4f">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="552" cellpadding="0" cellspacing="0" style="max-width:100%;background:#fff"><tr><td style="padding:32px">
<img src="https://www.firezone.dev/images/logo-lockup.png" width="200" alt="Firezone">
<h1 style="font-size:24px;color:#000"><%= @heading %></h1>
<p>Firezone account: <strong><%= @account.name %></strong> (<%= @account.slug %>)</p>
<p>Account ID: <%= @account.id %></p>
<p style="line-height:24px"><%= @message %></p>
<p style="line-height:24px"><%= @action %></p>
<p><a href="<%= @link %>" style="color:#5e00d6">View your Firezone account</a></p>
<p>Thanks,<br>The Firezone Team</p>
</td></tr></table></td></tr></table>
</body></html>
