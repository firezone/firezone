<div class="h-screen flex overflow-hidden">
  <%!-- Left panel --%>
  <div class="hidden lg:flex lg:w-[460px] shrink-0 bg-showcase flex-col justify-between p-12 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none dot-grid"></div>
    <div id="auth-brand" class="relative flex items-center gap-3">
      <img src="/images/logo.svg" class="h-10 w-auto shrink-0" alt="Firezone Logo" />
      <span class="text-2xl font-bold text-showcase-text tracking-tight">Firezone</span>
    </div>
    <div class="relative">
      <p class="text-3xl font-bold text-showcase-text leading-tight tracking-tight">
        Secure access.<br />Zero complexity.
      </p>
      <p class="text-sm text-showcase-text/60 mt-4 leading-relaxed">
        Connect your team to the infrastructure they need without opening holes in your network.
      </p>
      <div class="mt-8 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-showcase-text/10 border border-showcase-text/15 flex items-center justify-center shrink-0">
            <.icon name="ri-lock-2-line" class="w-3.5 h-3.5 text-showcase-icon" />
          </div>
          <span class="text-sm text-showcase-text/75">End-to-end encrypted with WireGuard</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-showcase-text/10 border border-showcase-text/15 flex items-center justify-center shrink-0">
            <.icon name="ri-shield-check-line" class="w-3.5 h-3.5 text-showcase-icon" />
          </div>
          <span class="text-sm text-showcase-text/75">Fine-grained access policies</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-showcase-text/10 border border-showcase-text/15 flex items-center justify-center shrink-0">
            <.icon name="ri-id-card-line" class="w-3.5 h-3.5 text-showcase-icon" />
          </div>
          <span class="text-sm text-showcase-text/75">Works with your existing identity provider</span>
        </div>
      </div>
    </div>
  </div>
  <%!-- Right panel --%>
  <div class="flex-1 flex items-center justify-center bg-surface overflow-y-auto">
    <div class="w-full max-w-lg px-6 py-12">
      <%!-- The left panel is hidden on small screens, so show the lockup here instead --%>
      <div id="auth-brand-mobile" class="flex lg:hidden items-center justify-center gap-3 mb-10">
        <img src="/images/logo.svg" class="h-10 w-auto shrink-0" alt="Firezone Logo" />
        <span class="text-2xl font-bold text-heading tracking-tight">Firezone</span>
      </div>
      {@inner_content}
    </div>
  </div>
</div>
