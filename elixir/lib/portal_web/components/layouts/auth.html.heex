<div class="min-h-screen lg:h-screen flex flex-col lg:flex-row lg:overflow-hidden bg-bg">
  <aside class="hidden lg:flex lg:w-[440px] shrink-0 flex-col justify-between p-12 bg-showcase text-showcase-text border-r border-hair">
    <div id="auth-brand" class="flex items-center gap-3">
      <img src="/images/logo.svg" class="h-8 w-auto shrink-0" alt="Firezone Logo" />
      <span class="text-2xl leading-none font-bold tracking-tight">Firezone</span>
    </div>

    <div>
      <p class="text-[11px] font-semibold tracking-[.12em] uppercase text-showcase-icon">
        Zero trust access
      </p>
      <p class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight">
        Secure access.<br />
        <span class="text-showcase-highlight">Zero complexity.</span>
      </p>
      <p class="mt-4 text-sm leading-relaxed text-showcase-icon">
        Connect your team to the infrastructure they need without opening holes in your network.
      </p>
      <ul class="mt-10 border-t border-showcase-icon/30">
        <li class="flex items-center gap-3 py-3 border-b border-showcase-icon/20 text-sm">
          <Core.icon name="ri-lock-2-line" class="w-4 h-4 shrink-0 text-showcase-icon" />
          End-to-end encrypted with WireGuard
        </li>
        <li class="flex items-center gap-3 py-3 border-b border-showcase-icon/20 text-sm">
          <Core.icon name="ri-shield-check-line" class="w-4 h-4 shrink-0 text-showcase-icon" />
          Fine-grained access policies
        </li>
        <li class="flex items-center gap-3 py-3 border-b border-showcase-icon/20 text-sm">
          <Core.icon name="ri-id-card-line" class="w-4 h-4 shrink-0 text-showcase-icon" />
          Works with your existing identity provider
        </li>
      </ul>
    </div>

    <p class="text-xs text-showcase-icon">
      Built on WireGuard. Open source.
    </p>
  </aside>

  <main class="flex-1 flex items-start sm:items-center justify-center lg:overflow-y-auto bg-bg">
    <div class="w-full max-w-md px-4 sm:px-6 pt-10 pb-12 lg:py-12">
      <div
        id="auth-brand-mobile"
        class="flex lg:hidden items-center gap-2.5 pb-6 mb-8 border-b border-rule"
      >
        <img src="/images/logo.svg" class="h-7 w-auto shrink-0" alt="Firezone Logo" />
        <span class="text-xl leading-none font-bold tracking-tight text-fg">Firezone</span>
      </div>
      <div id="auth-card" class="text-fg">
        {@inner_content}
      </div>
      <Page.data_residency_footer
        :if={!assigns[:hide_data_residency_footer]}
        path={
          assigns[:return_to] ||
            (assigns[:conn] && Phoenix.Controller.current_path(assigns[:conn]))
        }
      />
      <div
        id="auth-trust-mobile"
        class="flex lg:hidden flex-wrap justify-center gap-x-4 gap-y-2 mt-6 text-xs text-muted"
      >
        <span class="flex items-center gap-1">
          <Core.icon name="ri-lock-2-line" class="w-3.5 h-3.5" /> WireGuard encrypted
        </span>
        <span class="flex items-center gap-1">
          <Core.icon name="ri-shield-check-line" class="w-3.5 h-3.5" /> Fine-grained policies
        </span>
        <span class="flex items-center gap-1">
          <Core.icon name="ri-id-card-line" class="w-3.5 h-3.5" /> Bring your own IdP
        </span>
      </div>
    </div>
  </main>
</div>
