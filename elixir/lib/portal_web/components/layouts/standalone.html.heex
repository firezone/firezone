<div class="min-h-screen flex flex-col bg-bg text-fg">
  <div class="flex items-center gap-2.5 h-14 px-6 border-b border-hair shrink-0">
    <img src="/images/logo.svg" class="h-5 w-auto shrink-0" alt="Firezone Logo" />
    <span class="text-sm font-semibold tracking-tight">Firezone</span>
  </div>

  <div class="flex-1 flex items-start sm:items-center justify-center px-4 pt-10 pb-12">
    <div class="w-full max-w-lg">
      {@inner_content}
    </div>
  </div>
</div>
