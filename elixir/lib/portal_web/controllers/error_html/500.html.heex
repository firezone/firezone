<.error_page conn={@conn} code="500" title="Something went wrong">
  An unexpected error occurred on our end. Reload the page. If the problem stays, contact support.
  <:actions>
    <a
      href="https://firezone.statuspage.io"
      target="_blank"
      rel="noopener noreferrer"
      class={AuthPage.outline_button_class()}
    >
      Check platform status <Core.icon name="ri-external-link-line" class="w-4 h-4 text-muted" />
    </a>
  </:actions>
</.error_page>
