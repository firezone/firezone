<%= if @success do %>
  <AuthPage.result success title="Admin consent granted">
    <p>
      You have successfully granted permissions for directory sync. You can close this window and return to the settings page.
    </p>
    <:actions>
      <button type="button" data-close-window-button class={AuthPage.primary_button_class()}>
        Close window
      </button>
    </:actions>
  </AuthPage.result>
<% else %>
  <AuthPage.result success={false} title="Consent failed">
    <p class="text-attn">
      {Map.get(@flash, "error", "Something went wrong during the admin consent process.")}
    </p>
    <:actions>
      <button type="button" data-close-window-button class={AuthPage.primary_button_class()}>
        Close window
      </button>
    </:actions>
  </AuthPage.result>
<% end %>
